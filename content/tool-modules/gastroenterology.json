      ],
      "bankId": "gastroenterology",
      "bankLabel": "Гастроэнтерология",
      "category": "fluids",
      "description": "Расчёт ориентировочного объёма раствора ОРС на продолжающиеся потери после ввода массы, жидкого стула и эпизодов рвоты.",
      "estimatedMinutes": 2,
      "audience": "Дети; используется медицинским специалистом вместе с оценкой обезвоживания",
      "definition": {
        "schemaVersion": 1,
        "id": "minimed.calculator.pediatric-ors-ongoing-losses",
        "slug": "pediatric-ors-ongoing-losses",
        "title": "ОРС у детей — продолжающиеся потери",
        "shortTitle": "ОРС и потери",
        "aliases": [
          "Регидрон детям",
          "рвота понос",
          "продолжающиеся потери",
          "оральная регидратация"
        ],
        "summary": "Расчёт ориентировочного объёма раствора ОРС на продолжающиеся потери после ввода массы, жидкого стула и эпизодов рвоты.",
        "audience": "pediatric",
        "category": "fluids",
        "clinical": true,
        "formulaDisplay": "10 мл/кг за эпизод жидкого стула; 2 мл/кг за эпизод рвоты; поддерживающая потребность 100/50/20 и ориентир 50 мл/кг за 4 часа при дегидратации.",
        "population": "Дети, которые могут получать жидкость энтерально; масса 0,5–200 кг.",
        "limitations": [
          "Не определяет степень обезвоживания и не предназначен для шока, нарушения сознания или невозможности пить.",
          "Используйте готовый низкоосмолярный раствор ОРС; вода не заменяет электролиты.",
          "Тактика и скорость отпаивания требуют клинической коррекции и наблюдения."
        ],
        "inputs": [
          {
            "id": "weightKg",
            "label": "Масса тела",
            "unit": "кг",
            "kind": "number",
            "minimum": 0.5,
            "maximum": 200,
            "required": true,
            "step": 0
          },
          {
            "id": "diarrheaEpisodes",
            "label": "Эпизоды жидкого стула",
            "unit": "за текущий период",
            "kind": "number",
            "minimum": 0,
            "maximum": 50,
            "integer": true,
            "required": true,
            "step": 0
          },
          {
            "id": "vomitingEpisodes",
            "label": "Эпизоды рвоты",
            "unit": "за текущий период",
            "kind": "number",
            "minimum": 0,
            "maximum": 50,
            "integer": true,
            "required": true,
            "step": 0
          }
        ],
        "steps": [
          {
            "id": "stoolReplacement",
            "label": "На жидкий стул",
            "unit": "мл",
            "expression": "weightKg * 10 * diarrheaEpisodes",
            "displayPrecision": 0,
            "isOutput": false,
            "valueKind": "number",
            "stepRequired": 0
          },
          {
            "id": "vomitingReplacement",
            "label": "На рвоту",
            "unit": "мл",
            "expression": "weightKg * 2 * vomitingEpisodes",
            "displayPrecision": 0,
            "isOutput": false,
            "valueKind": "number",
            "stepRequired": 0
          },
          {
            "id": "ongoingLosses",
            "label": "ОРС на продолжающиеся потери",
            "unit": "мл",
            "expression": "stoolReplacement + vomitingReplacement",
            "displayPrecision": 0,
            "isOutput": true,
            "valueKind": "number",
            "stepRequired": 0
          },
          {
            "id": "maintenanceDaily",
            "label": "Поддерживающая потребность за сутки",
            "unit": "мл/сут",
            "expression": "cond(weightKg <= 10, weightKg * 100, cond(weightKg <= 20, 1000 + (weightKg - 10) * 50, 1500 + (weightKg - 20) * 20))",
            "displayPrecision": 0,
            "isOutput": true,
            "valueKind": "number",
            "stepRequired": 0
          },
          {
            "id": "rehydrationFourHours",
            "label": "Ориентир регидратации за 4 часа",
            "unit": "мл",
            "expression": "weightKg * 50",
            "displayPrecision": 0,
            "isOutput": true,
            "valueKind": "number",
            "stepRequired": 0
          }
        ],
        "warnings": [
          {
            "code": "clinical-review",
            "message": "Расчёт не заменяет оценку обезвоживания, электролитов, диуреза и способности ребёнка пить."
          }
        ],
        "interpretations": [],
        "assertions": [],
        "sources": [

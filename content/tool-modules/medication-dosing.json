            "id": "bsa",
            "label": "Площадь поверхности тела",
            "unit": "м²",
            "expression": "cond(formula == 1, sqrt(heightCm * weightKg / 3600), cond(formula == 2, 0.007184 * pow(weightKg, 0.425) * pow(heightCm, 0.725), cond(formula == 3, 0.024265 * pow(weightKg, 0.5378) * pow(heightCm, 0.3964), 0.0235 * pow(weightKg, 0.51456) * pow(heightCm, 0.42246))))",

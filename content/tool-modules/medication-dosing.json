      "bankId": "medication-dosing",
      "bankLabel": "Дозирование лекарств",
      "category": "medication",
      "description": "Эквивалентная доза системного глюкокортикоида при замене одного препарата на другой.",
      "estimatedMinutes": 1,
      "audience": "Любой возраст; только для приёма внутрь и внутривенного введения",
      "definition": {
        "schemaVersion": 2,
        "id": "minimed.calculator.glucocorticoid-equivalent-dose",
        "slug": "glucocorticoid-dose-conversion",
        "title": "Пересчёт доз глюкокортикоидов",
        "shortTitle": "Эквивалент ГКС",
        "aliases": [
          "эквивалентные дозы ГКС",
          "преднизолон в дексаметазон",
          "гидрокортизон в преднизолон",
          "метилпреднизолон преднизолон",
          "замена глюкокортикоида",
          "дексаметазон",
          "преднизолон",
          "стероиды перевод доз"
        ],
        "summary": "Эквивалентная доза системного глюкокортикоида при замене одного препарата на другой.",
        "ageScope": {
          "groups": ["neonates", "children", "adults"],
          "basis": "Определение: коэффициенты эквивалентности не зависят от возраста; ограничений по возрасту в источнике нет."
        },
        "category": "medication",
        "clinical": true,
        "formulaDisplay": "Доза нового препарата = доза исходного × (эквивалентная доза нового / эквивалентная доза исходного); за 1 принят гидрокортизон 20 мг",
        "population": "Пациенты, которым меняют системный глюкокортикоид; внутрь или внутривенно.",
        "limitations": [
          "Эквивалентные дозы ориентировочные и относятся к приёму внутрь и внутривенному введению; для внутримышечного, внутрисуставного и местного применения не подходят.",
          "Не учитывает длительность действия и минералокортикоидную активность: при замене на дексаметазон или бетаметазон схему и частоту приёма подбирают отдельно.",
          "Результат не является назначением; при длительной терапии учитывайте подавление надпочечников и схему снижения дозы."
        ],
        "inputs": [
          {
            "id": "fromDrug",
            "label": "Исходный препарат",
            "kind": "select",
            "required": true,
            "options": [
              {
                "value": 2,
                "label": "Гидрокортизон"
              },
              {
                "value": 1,
                "label": "Кортизон"
              },
              {
                "value": 3,
                "label": "Преднизон"
              },
              {
                "value": 4,
                "label": "Преднизолон"
              },
              {
                "value": 5,
                "label": "Метилпреднизолон"
              },
              {
                "value": 6,
                "label": "Триамцинолон"
              },
              {
                "value": 7,
                "label": "Дексаметазон"
              },
              {
                "value": 8,
                "label": "Бетаметазон"
              }
            ]
          },
          {
            "id": "dose",
            "label": "Доза исходного препарата",
            "unit": "мг",
            "kind": "number",
            "minimum": 0.01,
            "maximum": 2000,
            "required": true,
            "inputStep": 0.01
          },
          {
            "id": "toDrug",
            "label": "Новый препарат",
            "kind": "select",
            "required": true,
            "options": [
              {
                "value": 4,
                "label": "Преднизолон"
              },
              {
                "value": 3,
                "label": "Преднизон"
              },
              {
                "value": 2,
                "label": "Гидрокортизон"
              },
              {
                "value": 1,
                "label": "Кортизон"
              },
              {
                "value": 5,
                "label": "Метилпреднизолон"
              },
              {
                "value": 6,
                "label": "Триамцинолон"
              },
              {
                "value": 7,
                "label": "Дексаметазон"
              },
              {
                "value": 8,
                "label": "Бетаметазон"
              }
            ]
          }
        ],
        "steps": [
          {
            "id": "fromEquivalent",
            "label": "Эквивалентная доза исходного",
            "unit": "мг",
            "expression": "cond(fromDrug == 1, 25, cond(fromDrug == 2, 20, cond(fromDrug == 3, 5, cond(fromDrug == 4, 5, cond(fromDrug == 5, 4, cond(fromDrug == 6, 4, cond(fromDrug == 7, 0.75, cond(fromDrug == 8, 0.6, 0))))))))",
            "displayPrecision": 2,
            "isOutput": false
          },
          {
            "id": "toEquivalent",
            "label": "Эквивалентная доза нового",
            "unit": "мг",
            "expression": "cond(toDrug == 1, 25, cond(toDrug == 2, 20, cond(toDrug == 3, 5, cond(toDrug == 4, 5, cond(toDrug == 5, 4, cond(toDrug == 6, 4, cond(toDrug == 7, 0.75, cond(toDrug == 8, 0.6, 0))))))))",
            "displayPrecision": 2,
            "isOutput": false
          },
          {
            "id": "newDose",
            "label": "Доза нового препарата",
            "unit": "мг",
            "expression": "dose * toEquivalent / fromEquivalent",
            "displayPrecision": 2,
            "isOutput": true
          },
          {
            "id": "prednisolone",
            "label": "В пересчёте на преднизолон",
            "unit": "мг",
            "expression": "dose * 5 / fromEquivalent",
            "displayPrecision": 2,
            "isOutput": true
          }
        ],
        "warnings": [
          {
            "code": "oral-iv-only",
            "message": "Пересчёт только для приёма внутрь и внутривенного введения."
          },
          {
            "code": "verify-dose",
            "message": "Дозу, разведение и скорость подтверждайте по инструкции препарата и протоколу отделения."
          }
        ],
        "interpretations": [],
        "sources": [

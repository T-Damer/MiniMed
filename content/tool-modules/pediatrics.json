    {
      "id": "minimed.calculator.preterm-corrected-age",
      "kind": "calculator",
      "version": "1.0.0",
      "slug": "preterm-corrected-age",
      "title": "Корригированный возраст недоношенного",
      "shortTitle": "Корр. возраст",
      "aliases": [
        "скорректированный возраст",
        "adjusted age",
        "corrected age",
        "возраст недоношенного",
        "коррекция на недоношенность"
      ],
      "bankId": "pediatrics",
      "bankLabel": "Педиатрия",
      "category": "neonatology",
      "description": "Расчёт корригированного (скорректированного) возраста недоношенного ребёнка по гестационному и хронологическому возрасту в неделях.",
      "estimatedMinutes": 1,
      "audience": "Недоношенные дети; используется медицинским специалистом при оценке развития и роста",
      "definition": {
        "schemaVersion": 2,
        "id": "minimed.calculator.preterm-corrected-age",
        "slug": "preterm-corrected-age",
        "title": "Корригированный возраст недоношенного",
        "shortTitle": "Корр. возраст",
        "aliases": [
          "скорректированный возраст",
          "adjusted age",
          "corrected age",
          "возраст недоношенного",
          "коррекция на недоношенность"
        ],
        "summary": "Корригированный возраст = хронологический возраст (нед.) − (40 − гестационный возраст при рождении в нед.).",
        "audience": "pediatric",
        "category": "neonatology",
        "clinical": true,
        "formulaDisplay": "Недель недоношенности = 40 − СГР (нед.); корригированный возраст (нед.) = хронологический возраст (нед.) − недель недоношенности.",
        "population": "Недоношенные дети при оценке роста, питания и развития; полная коррекция возраста обычно применяется до 24 месяцев скорректированного возраста по рекомендациям AAP.",
        "limitations": [
          "Расчёт не заменяет клиническое суждение и не учитывает индивидуальную траекторию развития, сопутствующие заболевания или нейросенсорные нарушения.",
          "Коррекция предназначена прежде всего для оценки развития, роста и питания недоношенных; AAP рекомендует корректировать возраст до 24 месяцев скорректированного возраста при скрининге развития и построении кривых роста.",
          "При гестационном возрасте ≥37 недель (доношенный) коррекция по недоношенности обычно не показана."
        ],
        "inputs": [
          {
            "id": "gestationalAgeWeeks",
            "label": "Гестационный возраст при рождении",
            "unit": "нед.",
            "kind": "number",
            "minimum": 22,
            "maximum": 42,
            "integer": true,
            "required": true,
            "step": 0
          },
          {
            "id": "chronologicalAgeWeeks",
            "label": "Хронологический возраст",
            "unit": "нед.",
            "kind": "number",
            "minimum": 0,
            "maximum": 156,
            "integer": true,
            "required": true,
            "step": 0
          }
        ],
        "steps": [
          {
            "id": "weeksPremature",
            "label": "Недель недоношенности",
            "unit": "нед.",
            "expression": "40 - gestationalAgeWeeks",
            "displayPrecision": 0,
            "isOutput": false,
            "valueKind": "number",
            "stepRequired": 0
          },
          {
            "id": "correctedAgeWeeks",
            "label": "Корригированный возраст",
            "unit": "нед.",
            "expression": "chronologicalAgeWeeks - weeksPremature",
            "displayPrecision": 0,
            "isOutput": true,
            "valueKind": "number",
            "stepRequired": 0
          }
        ],
        "warnings": [
          {
            "code": "corrected-age-clinical-judgment",
            "message": "Используйте корригированный возраст вместе с клинической картиной; после 24 месяцев скорректированного возраста коррекция обычно не применяется для оценки развития по AAP."
          }
        ],
        "interpretations": [],
        "assertions": [
          {
            "when": "gestationalAgeWeeks >= 37",
            "error": "При гестационном возрасте ≥37 недель (доношенный) коррекция возраста по недоношенности обычно не применяется."
          }
        ],
        "sources": [
          {
            "title": "Corrected Age For Preemies",
            "publisher": "American Academy of Pediatrics (HealthyChildren.org)",
            "version": "2018",
            "url": "https://www.healthychildren.org/English/ages-stages/baby/preemie/pages/Corrected-Age-For-Preemies.aspx",
            "reviewedAt": "2026-08-17"
          },
          {
            "title": "An Evidentiary Review Regarding the Use of Chronological and Adjusted Age in the Assessment of Preterm Infants",
            "publisher": "Pediatrics in Review",
            "version": "2009",
            "url": "https://doi.org/10.1111/j.1744-6155.2009.00215.x",
            "reviewedAt": "2026-08-17"
          }
        ],
        "evaluation": {
          "status": "unavailable",
          "rules": [],
          "missingContext": [],
          "reason": "Проверенный референсный диапазон не заявлен в текущей версии инструмента.",
          "sourceIds": ["corrected-age-aap-healthychildren", "corrected-age-aap-evidentiary-review"]
        },
        "observationMappings": [
          {
            "metricId": "minimed.calculator.preterm-corrected-age.correctedAgeWeeks",
            "label": "Корригированный возраст",
            "unit": "нед.",
            "stepId": "correctedAgeWeeks",
            "method": "calculator:minimed.calculator.preterm-corrected-age"
          }
        ]
      },
      "sources": [
        {
          "id": "corrected-age-aap-healthychildren",
          "kind": "guideline",
          "relation": "methodology",
          "title": "Corrected Age For Preemies",
          "url": "https://www.healthychildren.org/English/ages-stages/baby/preemie/pages/Corrected-Age-For-Preemies.aspx",
          "reviewedAt": "2026-08-17"
        },
        {
          "id": "corrected-age-aap-evidentiary-review",
          "kind": "literature",
          "relation": "clinical-context",
          "title": "An Evidentiary Review Regarding the Use of Chronological and Adjusted Age in the Assessment of Preterm Infants",
          "url": "https://doi.org/10.1111/j.1744-6155.2009.00215.x",
          "reviewedAt": "2026-08-17"
        }
      ]
    },
    {
      "id": "minimed.calculator.pediatric-feeding-plan",
      "kind": "calculator",
      "version": "2.0.0",
      "slug": "pediatric-feeding-plan",
      "title": "Рацион и прикорм до 3 лет",
      "shortTitle": "Рацион ребёнка",
      "aliases": ["кормление ребёнка", "прикорм", "детский рацион", "меню ребёнка"],
      "bankId": "pediatrics",
      "bankLabel": "Педиатрия",
      "category": "pediatrics",
      "description": "Расчёт частоты, объёма и калорийности кормлений с печатным рационом и календарём прикорма.",
      "estimatedMinutes": 3,
      "audience": "Дети от рождения до 35,9 месяца; заполняет медицинский специалист",
      "definition": {
        "schemaVersion": 2,
        "id": "minimed.calculator.pediatric-feeding-plan",
        "slug": "pediatric-feeding-plan",
        "title": "Рацион и прикорм до 3 лет",
        "shortTitle": "Рацион ребёнка",
        "aliases": ["кормление ребёнка", "прикорм", "детский рацион", "меню ребёнка"],
        "summary": "Расчёт частоты, объёма и калорийности кормлений с печатным рационом и календарём прикорма.",
        "audience": "pediatric",
        "category": "pediatrics",
        "tags": ["fluids"],
        "clinical": true,
        "formulaDisplay": "До 12 месяцев: возрастная потребность в энергии × фактическая масса; после года: возрастная суточная потребность. Объём смеси учитывает её энергетическую плотность.",
        "population": "Доношенные дети от рождения до 35,9 месяца; лечебный рацион требует подтверждённого диагноза и клинического выбора смеси.",
        "limitations": [
          "Расчётные объёмы грудного молока являются ориентиром; кормление у груди сохраняют по требованию.",
          "Недоношенность, болезнь, нарушение набора массы и множественная пищевая аллергия требуют индивидуального плана."
        ],
        "inputs": [
          {
            "id": "ageMonths",
            "label": "Возраст ребёнка",
            "unit": "мес.",
            "kind": "number",
            "minimum": 0,
            "maximum": 35.9,
            "inputStep": 0.1,
            "required": true
          },
          {
            "id": "weightKg",
            "label": "Масса ребёнка",
            "unit": "кг",
            "kind": "number",
            "minimum": 1,
            "maximum": 30,
            "inputStep": 0.1,
            "required": true
          },
          {
            "id": "feedingMode",
            "label": "Тип вскармливания",
            "kind": "select",
            "required": true,
            "options": [
              { "value": "breast", "label": "Грудное" },
              { "value": "mixed", "label": "Смешанное" },
              { "value": "formula", "label": "Искусственное" }
            ]
          },
          {
            "id": "complementaryStatus",
            "label": "Прикорм",
            "kind": "select",
            "required": true,
            "options": [
              { "value": "not-started", "label": "Ещё не начат" },
              { "value": "starting", "label": "Начинаем введение" },
              { "value": "established", "label": "Уже введён" }
            ]
          },
          {
            "id": "feedsPerDay",
            "label": "Кормлений в сутки до 6 месяцев",
            "kind": "number",
            "minimum": 4,
            "maximum": 12,
            "integer": true,
            "required": false,
            "defaultExpression": "6"
          },
          {
            "id": "formulaKcalPer100Ml",
            "label": "Энергетическая плотность смеси",
            "unit": "ккал/100 мл",
            "kind": "number",
            "minimum": 50,
            "maximum": 100,
            "inputStep": 0.1,
            "required": false,
            "defaultExpression": "67",
            "note": "по маркировке смеси"
          },
          {
            "id": "measuredBreastMilkPerFeedMl",
            "label": "Измеренный объём грудного молока за кормление",
            "unit": "мл",
            "kind": "number",
            "minimum": 0,
            "maximum": 500,
            "inputStep": 1,
            "required": false,
            "defaultExpression": "0",
            "note": "для смешанного вскармливания"
          },
          {
            "id": "allergic",
            "label": "Ребёнок аллергичный",
            "kind": "checkbox",
            "required": false,
            "defaultExpression": "0"
          },
          {
            "id": "intoleranceCategory",
            "label": "Что не переносит ребёнок",
            "kind": "select",
            "required": true,
            "options": [
              { "value": "none", "label": "Нет исключений" },
              { "value": "milk", "label": "Белок коровьего молока / молочные продукты" },
              { "value": "gluten", "label": "Пшеница / глютен" },
              { "value": "egg", "label": "Яйцо" },
              { "value": "fish", "label": "Рыба" },
              { "value": "other", "label": "Другое" }
            ]
          },
          {
            "id": "excludedFoods",
            "label": "Конкретные продукты для исключения",
            "kind": "text",
            "required": false,
            "defaultExpression": "\"\"",
            "note": "через запятую"
          },
          {
            "id": "includeCalendar",
            "label": "Добавить календарь введения прикорма",
            "kind": "checkbox",
            "required": false,
            "defaultExpression": "0"
          }
        ],
        "steps": [
          {
            "id": "dailyCalories",
            "label": "Калорийность за сутки",
            "unit": "ккал",
            "expression": "cond(ageMonths < 7, round(weightKg * 115), cond(ageMonths < 12, round(weightKg * 110), cond(ageMonths < 24, 1200, 1400)))",
            "displayPrecision": 0,
            "isOutput": true
          },
          {
            "id": "volumeCap",
            "label": "Возрастной предел объёма",
            "unit": "мл",
            "expression": "cond(ageMonths >= 5, 1000, cond(ageMonths >= 4, 900, cond(ageMonths >= 3, 850, 10000)))",
            "displayPrecision": 0
          },
          {
            "id": "rawMilkVolume",
            "label": "Объём по энергетической плотности",
            "unit": "мл",
            "expression": "round(dailyCalories * 100 / formulaKcalPer100Ml)",
            "displayPrecision": 0
          },
          {
            "id": "dailyVolume",
            "label": "Объём за сутки",
            "unit": "г/мл",
            "expression": "cond(ageMonths < 6, min(rawMilkVolume, volumeCap), cond(ageMonths < 8, 840, cond(ageMonths < 9, 940, cond(ageMonths < 12, 1000, cond(ageMonths < 18, 1100, 1350)))))",
            "displayPrecision": 0,
            "isOutput": true
          },
          {
            "id": "feedingCount",
            "label": "Частота",
            "unit": "раз/сут",
            "expression": "cond(ageMonths < 6, feedsPerDay, 5)",
            "displayPrecision": 0,
            "isOutput": true
          },
          {
            "id": "oneFeedVolume",
            "label": "Средний объём одного кормления",
            "unit": "г/мл",
            "expression": "round(dailyVolume / feedingCount)",

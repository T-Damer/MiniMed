  "source": {
    "title": "Ретинопатия недоношенных",
    "recommendationId": "107_2",
    "approvedYear": 2025,
    "appliesFrom": "2026-01-19",
    "reviewDueNoLaterThan": 2027,
    "population": "children",
    "icd10": [
      "H35.1",
      "H35.2"
    ],
    "developer": [
      "Ассоциация врачей-офтальмологов",

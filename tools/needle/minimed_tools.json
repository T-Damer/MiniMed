[
  {
    "name": "search_medical_documents",
    "description": "Найти разделы клинических рекомендаций, нормативных документов или справочных статей по запросу врача; выполняет детерминированный поиск MiniMed",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "поисковая фраза словами пользователя"
        },
        "scope": {
          "type": "string",
          "enum": ["diagnosis", "guidelines", "medications", "legal"],
          "description": "ограничение семейства источников как в интерфейсе MiniMed"
        },
        "section": {
          "type": "string",
          "enum": [
            "clinical-picture",
            "differential-diagnosis",
            "diagnostics",
            "treatment",
            "routing",
            "follow-up"
          ],
          "description": "ожидаемый тип раздела документа"
        }
      },
      "required": ["query"]
    }
  },
  {
    "name": "lookup_drug",
    "description": "Найти препарат в справочнике по названию или действующему веществу",
    "parameters": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "название или действующее вещество как в запросе"
        },
        "age_years": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120,
          "description": "возраст пациента, если указан"
        },
        "weight_kg": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 400,
          "description": "масса пациента, если указана"
        }
      },
      "required": ["name"]
    }
  },
  {
    "name": "run_calculator",
    "description": "Выбрать медицинский калькулятор и подставить в него значения из текста пользователя; сам расчёт выполняет приложение",
    "parameters": {
      "type": "object",
      "properties": {
        "calculator_id": {
          "type": "string",
          "description": "идентификатор калькулятора из каталога MiniMed"
        },
        "age_years": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "weight_kg": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 400
        },
        "birth_weight_kg": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 8
        },
        "height_cm": {
          "type": "number",
          "minimum": 30,
          "maximum": 230
        },
        "dose_mg_kg": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100
        },
        "sex": {
          "type": "string",
          "enum": ["male", "female"]
        },
        "creatinine_umol_l": {
          "type": "number",
          "minimum": 10,
          "maximum": 2000
        },
        "sodium_mmol_l": {
          "type": "number",
          "minimum": 90,
          "maximum": 180
        },
        "urine_sodium_mmol_l": {
          "type": "number",
          "minimum": 5,
          "maximum": 400
        },
        "potassium_mmol_l": {
          "type": "number",
          "minimum": 1,
          "maximum": 9
        },
        "chloride_mmol_l": {
          "type": "number",
          "minimum": 60,
          "maximum": 140
        },
        "bicarbonate_mmol_l": {
          "type": "number",
          "minimum": 2,
          "maximum": 60
        },
        "glucose_mmol_l": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 45
        },
        "urea_mmol_l": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 50
        },
        "urine_urea_mmol_l": {
          "type": "number",
          "minimum": 10,
          "maximum": 1500
        },
        "urine_creatinine_umol_l": {
          "type": "number",
          "minimum": 500,
          "maximum": 50000
        },
        "albumin_g_l": {
          "type": "number",
          "minimum": 5,
          "maximum": 70
        },
        "ast_u_l": {
          "type": "number",
          "minimum": 3,
          "maximum": 10000
        },
        "alt_u_l": {
          "type": "number",
          "minimum": 3,
          "maximum": 10000
        },
        "platelets_10_9_l": {
          "type": "number",
          "minimum": 1,
          "maximum": 1500
        },
        "wbc_10_9_l": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100
        },
        "neutrophils_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "bands_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "mcv_fl": {
          "type": "number",
          "minimum": 40,
          "maximum": 160
        },
        "rbc_10_12_l": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 8
        },
        "heart_rate_bpm": {
          "type": "number",
          "minimum": 20,
          "maximum": 260
        },
        "systolic_bp_mmhg": {
          "type": "number",
          "minimum": 40,
          "maximum": 280
        },
        "qt_ms": {
          "type": "number",
          "minimum": 200,
          "maximum": 700
        },
        "rr_seconds": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 2
        },
        "tbsa_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "hours_since_burn": {
          "type": "number",
          "minimum": 0,
          "maximum": 48
        },
        "urine_volume_ml": {
          "type": "number",
          "minimum": 1,
          "maximum": 5000
        },
        "collection_hours": {
          "type": "number",
          "minimum": 1,
          "maximum": 24
        },
        "vomiting_episodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "diarrhea_episodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        }
      },
      "required": ["calculator_id"]
    }
  },
  {
    "name": "run_assessment",
    "description": "Открыть шкалу или опросник из каталога MiniMed для оценки состояния пациента",
    "parameters": {
      "type": "object",
      "properties": {
        "assessment_id": {
          "type": "string",
          "enum": [
            "glasgow-coma-scale",
            "alvarado-appendicitis",
            "flacc-pain-scale",
            "apgar",
            "epds",
            "ferriman-gallwey",
            "whooley",
            "pucai",
            "vesikari-gastroenteritis",
            "partial-mayo-score",
            "braverman-behavioral",
            "egogram",
            "paei",
            "team-roles",
            "temperament",
            "silverman-andersen-respiratory-distress",
            "downes-vidyasagar-respiratory-distress",
            "nips-neonatal-infant-pain-scale",
            "ballard-neonatal-gestational-age"
          ],
          "description": "идентификатор шкалы или опросника"
        }
      },
      "required": ["assessment_id"]
    }
  },

{
  "name": "@localmed/benchmarks",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "benchmark:regulatory": "tsx src/run-regulatory.ts",
    "benchmark:clinician": "tsx src/run-curated-clinician.ts",
    "benchmark:esklp-full-medication": "bun src/run-esklp-full-medication.ts",
    "benchmark:full-corpus:generate:diseases": "bun src/generate-full-corpus-search-fixtures.ts --source=diseases --database=../../data/build/diseases.db --output=../../data/build/diseases-full-search-queries.json",
    "benchmark:full-corpus:generate:mkb-diseases": "bun src/generate-full-corpus-search-fixtures.ts --source=mkb-diseases --database=../../data/build/mkb-diseases.db --output=../../data/build/mkb-diseases-full-search-queries.json",
    "benchmark:full-corpus:diseases": "bun src/run-full-corpus-search.ts --source=diseases --database=../../data/build/diseases.db --fixture=../../data/build/diseases-full-search-queries.json --report=../../data/build/diseases-full-search-report.json",
    "benchmark:full-corpus:mkb-diseases": "bun src/run-full-corpus-search.ts --source=mkb-diseases --database=../../data/build/mkb-diseases.db --fixture=../../data/build/mkb-diseases-full-search-queries.json --report=../../data/build/mkb-diseases-full-search-report.json",
    "benchmark:parser": "tsx src/run-query-parser.ts",
    "benchmark:parser:generated": "tsx src/run-query-parser-generated.ts",
    "benchmark:rag-500": "bun src/rag-500-benchmark.ts",
    "benchmark:rag-prototype": "bun src/rag-prototype.ts",
    "ecg:check": "tsx src/check-ecg-image-dataset.ts",
    "ecg:collect": "tsx src/collect-ecg-images.ts",
    "ecg:evaluate": "tsx src/evaluate-ecg-photo-benchmark.ts",
    "ecg:evaluate:numeric": "tsx src/evaluate-ecg-numeric-solver.ts",
    "review:aliases": "tsx src/alias-review-batch.ts && tsx src/generate-review-ui.ts",
    "benchmark:runtime": "bun src/run-runtime-retrieval.ts",
    "benchmark:search-quality-v2": "bun run benchmark:lookup-quality",
    "benchmark:lookup-quality": "bun src/run-lookup-quality.ts",
    "benchmark:doctor-lookup": "bun src/run-doctor-lookup.ts",
    "benchmark:core-coverage": "bun src/run-core-coverage.ts",
    "benchmark:real": "bun src/run-real-corpus.ts",
    "benchmark:search-coverage-observations": "bun src/run-search-coverage-observations.ts",
    "benchmark:rapidfuzz-micro": "bun src/rapidfuzz-microbenchmark.ts",
    "benchmark:typo-correction": "bun src/run-typo-correction.ts",
    "benchmark:retrieval:build": "bun src/build-retrieval-benchmark.ts",
    "benchmark:retrieval": "bun src/run-retrieval-benchmark.ts"
  },
  "dependencies": {
    "@localmed/contracts": "workspace:*",
    "@localmed/core": "workspace:*",
    "@localmed/domain": "workspace:*",
    "@localmed/search-lexical": "workspace:*",
    "@localmed/storage-capacitor": "workspace:*",
    "@localmed/storage-sqlite": "workspace:*",
    "@localmed/test-fixtures": "workspace:*",
    "@localmed/search-semantic": "workspace:*",
    "yaml": "2.9.0",
    "@localmed/storage": "workspace:*"
  },
  "exports": {
    "./real-corpus": "./src/real-corpus.ts",
    "./bun-sqlite-medical-store": "./src/bun-sqlite-medical-store.ts",
    "./observe-store-search": "./src/observe-store-search.ts"
  }
}

---
import '../styles/global.css';
import '../styles/release.css';

import { ANDROID_APK_URL, GITHUB_REPOSITORY_URL, RELEASE_VERSION } from '../../../../release';

// biome-ignore lint/correctness/noUnusedVariables: Astro consumes these values in the template.
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL ?? GITHUB_REPOSITORY_URL;
// biome-ignore lint/correctness/noUnusedVariables: Astro consumes these values in the template.
const appUrl = `${import.meta.env.BASE_URL.replace(/\/$/u, '')}/app/`;
// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template.
const apkUrl = ANDROID_APK_URL;

// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template.
const milestones = [
  {
    version: '0.5',
    state: 'готово',
    title: 'Полный каталог',
    copy: '744 структурированных модуля клинических рекомендаций из официального JSON-каталога.',
  },
  {
    version: RELEASE_VERSION,
    state: 'текущий релиз',
    title: 'Напоминания и вложения',
    copy: 'Офлайн-поиск, локальные уведомления без push-сервера и изображения заметок только на устройстве.',
  },
  {
    version: '1.0',
    state: 'следующая цель',
    title: 'Проверенный помощник',
    copy: 'Больше реальных врачебных сценариев и измеренная точность, цитирование и сдержанность модели.',
  },
  {
    version: '1.1',
    state: 'идея после 1.0',
    title: 'Портативное Rust-ядро',
    copy: 'Единое ядро и CLI для браузера, мобильных платформ, терминала и автоматизированных проверок.',
  },
];

// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template.
const stats = [
  ['Клинические рекомендации', '744 модуля'],
  ['Медицинские разделы', '21'],
  ['Загрузки документов', 'до 3 одновременно'],
  ['Работа без сети', 'Да'],
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="MiniMed — локальный медицинский поиск по клиническим рекомендациям, инструкциям и нормативным документам."
    />
    <meta name="theme-color" content="#48453f" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <title>MiniMed — локальное рабочее место врача</title>
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <header class="archive-nav">
      <a class="brand" href="#top" aria-label="MiniMed — к началу страницы">
        <img class="brand-mark brand-mark-image" src="./favicon.svg" alt="" width="38" height="38" />
        <span class="brand-title">
          <small>Локальная медицинская</small>
          <strong>MiniMed</strong>
        </span>
      </a>
      <nav aria-label="Навигация по странице">
        <a href="#capabilities">Возможности</a>
        <a href="#workflow">Как работает</a>
        <a href="#roadmap">Версии</a>
        <a class="repo-link" href={githubUrl}>GitHub ↗</a>
        <a class="app-link" href={appUrl}>Открыть приложение →</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero-folder">
        <div class="folder-tab">MINIMED · RELEASE {RELEASE_VERSION}</div>
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="kicker">Offline-first · retrieval before generation</p>
            <h1>Медицинский поиск, который открывает сам источник.</h1>
            <p class="lead">
              Выберите задачу: разобрать клинический случай, найти клиническую рекомендацию,
              препарат или правовой документ. Загруженные источники, заметки и напоминания остаются
              на устройстве, а локальная модель подключается только в диагностическом режиме.
            </p>
            <div class="hero-actions">
              <a class="primary-action" href={appUrl}>Открыть MiniMed в браузере</a>
              <a class="text-action" href={apkUrl}>Скачать APK {RELEASE_VERSION} ↓</a>
              <a class="text-action" href={githubUrl}>Исходный код ↗</a>
            </div>
          </div>

          <aside class="case-card" aria-label="Пример работы поиска">
            <span class="paper-clip" aria-hidden="true"></span>
            <div class="card-header">
              <span>КАРТОЧКА ЗАПРОСА</span>
              <b>LOCAL / {RELEASE_VERSION}</b>
            </div>
            <p class="case-query">
              Цефтриаксон ребёнку 3 лет, вес 20 кг, при пневмонии как второй антибиотик.
            </p>
            <dl class="fact-ledger">
              <div><dt>возраст</dt><dd>3 года</dd></div>
              <div><dt>масса</dt><dd>20 кг</dd></div>
              <div><dt>контекст</dt><dd>пневмония</dd></div>
              <div><dt>задача</dt><dd>проверить препарат</dd></div>
            </dl>
            <div class="result-slip">
              <small>ПРАВИЛО БЕЗОПАСНОСТИ</small>
              <strong>Показывать дозу только вместе с точным источником</strong>
              <p>Если установленный документ не подтверждает режим, MiniMed должен воздержаться.</p>
            </div>
          </aside>
        </div>
      </section>

      <section class="release-strip" aria-label="Состояние корпуса">
        {stats.map(([label, value]) => (
          <div><span>{label}</span><strong>{value}</strong></div>
        ))}
      </section>

      <section class="dossier-section" id="capabilities">
        <div class="section-register">
          <span>РАБОЧЕЕ МЕСТО / 01</span>
          <strong>Три раздела и необязательная локальная модель</strong>
        </div>
        <div class="dossier-grid">
          <article>
            <div class="dossier-card-topline">
              <svg class="dossier-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="10.5" cy="10.5" r="6.5"></circle>
                <path d="m15.4 15.4 4.1 4.1"></path>
              </svg>
              <span>01</span>
            </div>
            <h2>Поиск</h2>
            <p>Пять режимов, свободный медицинский ввод, история запросов и точные фрагменты источников.</p>
          </article>
          <article>
            <div class="dossier-card-topline">
              <svg class="dossier-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m12 3 8 4-8 4-8-4 8-4Z"></path>
                <path d="m4 12 8 4 8-4M4 17l8 4 8-4"></path>
              </svg>
              <span>02</span>
            </div>
            <h2>База знаний</h2>
            <p>744 рекомендации в 21 разделе, таблицы и изображения из JSON, поиск и чтение без сети.</p>
          </article>
          <article>
            <div class="dossier-card-topline">
              <svg class="dossier-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 3.5h9.5L19 7v13.5H6Z"></path>
                <path d="M15 3.5V7h4M9 11h7M9 14.5h7M9 18h4.5"></path>
              </svg>
              <span>03</span>
            </div>
            <h2>Заметки</h2>
            <p>Локальные карточки, отдельные записи и напоминания с категоризацией и поиском по устройству.</p>
          </article>
          <article>
            <div class="dossier-card-topline">
              <svg class="dossier-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9.2 4.8A3.2 3.2 0 0 0 6 8v.4a3.4 3.4 0 0 0-1.8 5.9A3.6 3.6 0 0 0 7.6 20H10V4.8Z"></path>
                <path d="M14.8 4.8A3.2 3.2 0 0 1 18 8v.4a3.4 3.4 0 0 1 1.8 5.9 3.6 3.6 0 0 1-3.4 5.7H14V4.8Z"></path>
                <path d="M10 8.1c-1 .2-1.8 1-1.8 2 0 1 .7 1.8 1.8 2M14 8.1c1 .2 1.8 1 1.8 2 0 1-.7 1.8-1.8 2"></path>
              </svg>
              <span>04</span>
            </div>
            <h2>Локальная модель</h2>
            <p>Необязательная помощь поверх найденных источников; модель загружается независимо от документов.</p>
          </article>
        </div>
      </section>

      <section class="workflow-section" id="workflow">
        <div class="section-register">
          <span>МЕТОД / 02</span>
          <strong>Как система ограничивает ошибки</strong>
        </div>
        <div class="workflow-grid">
          <div class="workflow-intro">
            <p class="kicker">Не чат поверх пустоты</p>
            <h2>Сначала локальный корпус, затем помощь модели.</h2>
            <p>
              Обычный поиск не зависит от нейросети. В диагностическом режиме локальная модель может
              разбирать только уже найденные материалы и обязана сохранять видимые ссылки.
            </p>
          </div>
          <div class="workflow-steps">
            <article><span>01</span><h3>Выбрать задачу</h3><p>КР, препараты, право, все источники или диагностический разбор.</p></article>
            <article><span>02</span><h3>Найти доказательства</h3><p>FTS5 и переносимые embeddings объединяются без потери точных совпадений.</p></article>
            <article><span>03</span><h3>Открыть документ</h3><p>Врач получает исходный фрагмент; неподтверждённый вывод не становится фактом.</p></article>
          </div>
        </div>
      </section>

      <section class="roadmap-section" id="roadmap">
        <div class="section-register">
          <span>ОПИСЬ / 03</span>
          <strong>Версии и границы</strong>
        </div>
        <div class="roadmap-table">
          {milestones.map((milestone) => (
            <article class:list={{ current: milestone.version === RELEASE_VERSION }}>
              <span class="version-tab">{milestone.version}</span>
              <div><small>{milestone.state}</small><h2>{milestone.title}</h2><p>{milestone.copy}</p></div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer>
      <span>MINIMED / RELEASE {RELEASE_VERSION}</span>
      <span>Справочно-поисковая система · не заменяет решение врача</span>
      <a href={appUrl}>Открыть приложение →</a>
    </footer>
  </body>
</html>

---
import '../styles/global.css';
import '../styles/demos.css';
import '../styles/appearance.css';

import { ANDROID_APK_URL, GITHUB_REPOSITORY_URL } from '../../../../release';
// biome-ignore lint/correctness/noUnusedImports: Astro renders this component in the template.
import FeatureShowcase from '../components/FeatureShowcase.astro';

// biome-ignore lint/correctness/noUnusedVariables: Astro consumes these values in the template.
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL ?? GITHUB_REPOSITORY_URL;
// biome-ignore lint/correctness/noUnusedVariables: Astro consumes these values in the template.
const appUrl = `${import.meta.env.BASE_URL.replace(/\/$/u, '')}/app/`;
// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template.
const apkUrl = ANDROID_APK_URL;
// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template.
const pageUrl = new URL(import.meta.env.BASE_URL, Astro.site).toString();
// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template.
const ogImageUrl = new URL(
  `${import.meta.env.BASE_URL.replace(/\/$/u, '')}/og-minimed.png`,
  Astro.site,
).toString();
---

<!doctype html>
<html lang="ru" class="landing">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.toggle('landing--dark', window.matchMedia('(prefers-color-scheme: dark)').matches);</script>
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="MiniMed — локальный медицинский поиск по клиническим рекомендациям, инструкциям и нормативным документам."
    />
    <meta name="theme-color" content="#f3ecd9" />
    <link rel="icon" href="./favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="./favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="./favicon-64.png" />
    <!-- OG previews -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="MiniMed" />
    <meta property="og:title" content="MiniMed — локальное рабочее место врача" />
    <meta
      property="og:description"
      content="Локальный медицинский поиск по клиническим рекомендациям, инструкциям и нормативным документам."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="MiniMed — локальный медицинский поиск по источникам"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="MiniMed — локальное рабочее место врача" />
    <meta
      name="twitter:description"
      content="Клинические рекомендации, препараты и документы — рядом даже без сети."
    />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>MiniMed — локальное рабочее место врача</title>
  </head>
  <body class="landing__body">
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <main class="landing__main" id="main">
      <article class="sheet" id="top">
        <div class="sheet__meta">
          <span class="sheet__label">MiniMed</span>
          <div class="sheet__settings"><button class="sound-toggle" type="button" aria-pressed="false" data-theme-toggle>Тёмная тема</button>
          <button class="sound-toggle sound-toggle--enabled" type="button" aria-pressed="true" aria-label="Звуки интерфейса" data-sound-toggle>
            <img class="sound-toggle__icon" src="./icons/speaker-high.svg" alt="" width="20" height="20" data-sound-icon />
            <span data-sound-label>Звук вкл.</span>
          </button></div>
        </div>
        <section class="intro" aria-labelledby="title">
          <div class="intro__identity">
            <img class="intro__mark" src="./favicon.png" alt="" width="64" height="64" />
            <h1 class="intro__title" id="title">MiniMed</h1>
          </div>
          <p class="intro__description">Оффлайн медицинский справочник</p>
        </section>

        <FeatureShowcase />

        <section class="access" id="download" aria-labelledby="access-title">
          <div class="access__heading">
            <h2 class="access__title" id="access-title">Загрузить или пользоваться</h2>
          </div>
          <div class="access__options">
            <article class="access-option">
              <span class="access-option__label">На телефоне</span>
              <h3 class="access-option__title">Android</h3>
              <p class="access-option__description">Установите приложение из APK-файла.</p>
              <a class="button" href={apkUrl} data-sound="press">Скачать APK <img class="button__icon button__icon--light" src="./icons/download-simple.svg" alt="" width="20" height="20" /></a>
            </article>
            <article class="access-option access-option--browser">
              <span class="access-option__label">На компьютере и телефоне</span>
              <h3 class="access-option__title">В браузере</h3>
              <p class="access-option__description">Откройте MiniMed без установки.</p>
              <a class="button button--outline" href={appUrl} data-sound="open">Открыть <img class="button__icon" src="./icons/arrow-up-right.svg" alt="" width="20" height="20" /></a>
            </article>
          </div>
        </section>

        <footer class="sheet__footer"><p class="sheet__disclaimer">MiniMed — справочно-поисковая система.<br />Не заменяет решение врача.</p><a class="text-link" href={githubUrl} data-sound="press">GitHub ↗</a></footer>
      </article>
    </main>
    <script>
      import '../scripts/landing';
      import '../scripts/demos';
      import '../scripts/showcase';
    </script>
  </body>
</html>

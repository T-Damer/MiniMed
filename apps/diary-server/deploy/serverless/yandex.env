# The serverless diary in Yandex Cloud (ADR-0027, docs/DIARY_ADMIN.md). Ids, not secrets.
YC_FOLDER=b1ginjm6vtsvrqgd96qq
YC_REGISTRY=crp5ismdqdfuaku4ee3g
YC_CONTAINER=diary-api
YC_CONTAINER_ID=bbaheclhtg6v320k1cbq
YC_GATEWAY=diary
# Runs the container: ydb.editor and container-registry.images.puller on the folder.
YC_RUNTIME_SA=ajehtintrtcr47v0aku3
# Used by the gateway to call the container: serverless-containers.containerInvoker.
YC_INVOKER_SA=ajevida0fu815bv4mb7i
DIARY_YDB="grpcs://ydb.serverless.yandexcloud.net:2135/?database=/ru-central1/b1gpdrmddfporukd7enk/etn6vhhm6g7seghpapdh"
DIARY_SIGNUP=open
DIARY_PUSH_SUBJECT=mailto:admin@1damer.com
# Pages and native shells that may call the API (semicolons: yc takes commas between variables).
DIARY_CORS_ORIGINS="https://t-damer.github.io;https://t-damer.gitverse.site;https://localhost;capacitor://localhost"
# Where med.1damer.com (/, /diary, /demo, /demo/patient) redirects: the published app, ending in «/».
# GitVerse Pages since 2026-11-03 (opens reliably in Russia; scripts/diary-gitverse-publish.sh);
# GitHub Pages is https://t-damer.github.io/MiniMed/app/. Redeploy with GATEWAY_ONLY=1.

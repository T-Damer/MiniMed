# Copy to .env next to compose.yaml.
DIARY_DOMAIN=med.example.org
# A tag from ghcr.io/t-damer/minimed-diary (release version), or a locally built image.
DIARY_IMAGE=ghcr.io/t-damer/minimed-diary:latest
# open: anyone may sign up as a doctor; invite: only with a code from `bun diary-cli.js invite`.
DIARY_SIGNUP=invite
DIARY_PUSH_SUBJECT=mailto:admin@example.org
# Host folder for the daily database copies (kept 14 days by default).
DIARY_BACKUP_DIR=./backups
DIARY_BACKUP_AT=03:30
DIARY_BACKUP_KEEP=14
TZ=Europe/Moscow

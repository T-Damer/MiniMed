# Local Android prerelease signing credentials (copy to android-release.local.env; gitignored).
# Must match PRERELEASE_CERT_SHA256 (7749bab3dbe763d9a3c2092ded6e2700f48c3dd86dc9ba780394c1d3684d0b16)
# so APKs install over previous releases without clearing user data.
#
# Provide EITHER MINIMED_ANDROID_KEYSTORE_FILE (path to local .p12) OR MINIMED_ANDROID_KEYSTORE_BASE64.
MINIMED_ANDROID_KEYSTORE_FILE=/path/to/minimed-prerelease.p12
# MINIMED_ANDROID_KEYSTORE_BASE64=
MINIMED_ANDROID_KEYSTORE_PASSWORD=replace-me
MINIMED_ANDROID_KEY_ALIAS=replace-me
